# Private key for deployments (without 0x prefix)
PRIVATE_KEY=

# Celoscan API key for contract verification
CELOSCAN_API_KEY=

# Platform wallet address (receives fees)
PLATFORM_WALLET=

# Admin address
ADMIN_ADDRESS=

# RPC URLs (optional, defaults set in foundry.toml)
CELO_RPC_URL=https://forno.celo.org
CELO_TESTNET_RPC_URL=https://alfajores-forno.celo-testnet.org